{
  "rules": {
    "pedidos": {
      "$dia": {
        ".read": "$dia.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/)",
        "$hora": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "$dia.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/) && $hora.matches(/^h(09|1[0-7])$/) && newData.hasChildren(['nome', 'em']) && (!newData.child('ok').exists() || data.exists())",
          "nome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "em": { ".validate": "newData.val() == now" },
          "ok": {
            ".write": "auth != null && auth.token.email == 'luique@varanda.barber'",
            ".validate": "newData.val() == true"
          },
          "$outro": { ".validate": false }
        }
      }
    }
  }
}
